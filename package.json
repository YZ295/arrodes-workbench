    "build:portable": "node arrodes/scripts/build-portable.mjs"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "exceljs": "4.4.0",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.13.0",
    "papaparse": "5.5.3",
    "unpdf": "2.1.0"
  }
}
