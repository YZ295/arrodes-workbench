{
  "name": "arrodes-workbench",
  "private": true,
  "version": "1.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build:runtime": "node arrodes/scripts/build-runtime.mjs",
    "start": "npm run build:runtime && electron arrodes",
    "test": "npm run build:runtime && node --test arrodes/tests/*.test.mjs",
    "test:desktop": "npm run build:runtime && node --test arrodes/tests/stage-a.test.cjs",
    "build:portable": "node arrodes/scripts/build-portable.mjs release"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
